# Copie para .env e preencha. O .env nunca vai para o Git.
# Tudo que começa com VITE_ vai para o navegador: nunca coloque a chave secreta aqui.

# Endereço da API (o backend em desenvolvimento roda na porta 3000)
VITE_API_URL=http://localhost:3000

# URL do projeto (painel do Supabase > Project Settings > Data API)
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co

# Chave pública (sb_publishable_...) ou, em projetos antigos, a anon
VITE_SUPABASE_PUBLISHABLE_KEY=
