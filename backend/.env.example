# Copie para .env e preencha. O .env nunca vai para o Git.

# URL do projeto (painel do Supabase > Project Settings > Data API)
SUPABASE_URL=https://SEU_PROJETO.supabase.co

# Chave secreta (sb_secret_...) ou, em projetos antigos, a service_role.
# Dá acesso total ao banco: só no backend, nunca no frontend.
SUPABASE_SECRET_KEY=

PORT=3000

# Origens que podem chamar a API (separe por vírgula se houver mais de uma)
CORS_ORIGIN=http://localhost:5173

# Endereço do frontend, usado no link dos e-mails de convite
FRONTEND_URL=http://localhost:5173
